{
	"version": 1,
	"base_image": "codeocean/mambaforge3:23.1.0-4-python3.10.12-ubuntu22.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"mamba": {
			"packages": [
				{
					"name": "caiman",
					"version": "1.10.3"
				}
			]
		},
		"pip3": {
			"packages": [
				{
					"name": "aind-data-schema",
					"version": "2.8.1"
				},
				{
					"name": "aind-ophys-utils",
					"version": "0.2.0"
				},
				{
					"name": "aind-qcportal-schema",
					"version": "0.6.4"
				},
				{
					"name": "cellpose",
					"version": "3.0.10"
				},
				{
					"name": "git+https://github.com/AllenNeuralDynamics/aind-ophys-extraction-library.git@3a2abda#egg=aind-ophys-extraction-library"
				},
				{
					"name": "git+https://github.com/j-friedrich/suite2p.git@save_cellpose_output#egg=suite2p"
				},
				{
					"name": "h5py",
					"version": "3.11.0"
				},
				{
					"name": "pydantic",
					"version": "2.8.2"
				},
				{
					"name": "pydantic-settings",
					"version": "2.14.2"
				},
				{
					"name": "sbxreader",
					"version": "0.2.3"
				},
				{
					"name": "scikit-image",
					"version": "0.24.0"
				},
				{
					"name": "sparse",
					"version": "0.15.4"
				},
				{
					"name": "torch",
					"version": "2.4.0"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	},
	"env_variables": [
		{
			"name": "CAIMAN_TEMP",
			"value": "/scratch"
		}
	]
}